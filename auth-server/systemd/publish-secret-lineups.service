[Unit]
Description=Publish due Carcassonne GG secret match lineups
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/carcassonne-gg/auth-server
LogsDirectory=carcassonne
Environment=DB_PATH=/home/carcassonne-gg/auth-server/data/auth.sqlite
StandardOutput=append:/var/log/carcassonne/publish-secret-lineups.log
StandardError=append:/var/log/carcassonne/publish-secret-lineups.log
ExecStart=/usr/bin/flock -n /tmp/carcassonne-publish-secret-lineups.lock /usr/bin/node /home/carcassonne-gg/auth-server/src/publish-secret-lineups.js
TimeoutStartSec=1min

[Install]
WantedBy=multi-user.target
